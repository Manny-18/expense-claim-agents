# Copy to .env and edit. Every value is optional: with none of them set the system
# runs the deterministic rule engine, which is the tested default.

# offline | ollama | gemini | openai
LLM_PROVIDER=offline

# Local model through Ollama (no key, no data leaves the machine)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434

# Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your_key_here

# Any OpenAI compatible endpoint
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT=60
